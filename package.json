{
  "name": "dsh-plugin-feishu-docs",
  "version": "3.8.2",
  "description": "Feishu documents of each Session, read from its own log: a header chip and a per-day popover with a jump to the turn.",
  "author": "WaterLiu",
  "type": "module",
  "files": [
    "index.js",
    "scan.js",
    "avatar.js",
    "owners.js",
    "setup.js",
    "org.js",
    "cli.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "tools/check-undefined.mjs",
    "contrib",
    "docs",
    "icon.svg",
    "README.md",
    "INSTALL.md",
    "LICENSE"
  ],
  "scripts": {
    "check-undefined": "node tools/check-undefined.mjs index.js scan.js owners.js setup.js org.js cli.js avatar.js client.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "feishu",
    "lark",
    "documents"
  ],
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaterLiu/dsh-plugin-feishu-docs.git"
  }
}
