<mxfile host="drawio" version="32.6.10">
  <diagram id="market-flow" name="DSH 插件上架流程">
    <mxGraphModel dx="1400" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="把插件发布到 DSH 市场 —— 全流程" style="text;html=1;fontSize=22;fontStyle=1;fontColor=#12284B;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="900" height="40" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="共 6 步，2–4 天。其中「等满 24 小时」是 CI 硬门槛，不是审核。" style="text;html=1;fontSize=13;fontColor=#6B7280;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="58" width="900" height="26" as="geometry" />
        </mxCell>

        <mxCell id="lane1" value="你（插件作者）" style="swimlane;html=1;startSize=34;rounded=1;arcSize=2;fillColor=#F7F9FC;strokeColor=#D0D7E5;fontStyle=1;fontSize=14;fontColor=#1F3864;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="110" width="420" height="700" as="geometry" />
        </mxCell>
        <mxCell id="lane2" value="awesome-dsh-plugin（目录仓库）" style="swimlane;html=1;startSize=34;rounded=1;arcSize=2;fillColor=#F7F9FC;strokeColor=#D0D7E5;fontStyle=1;fontSize=14;fontColor=#1F3864;align=center;" vertex="1" parent="1">
          <mxGeometry x="520" y="110" width="420" height="700" as="geometry" />
        </mxCell>
        <mxCell id="lane3" value="dshmarket（市场应用）" style="swimlane;html=1;startSize=34;rounded=1;arcSize=2;fillColor=#F7F9FC;strokeColor=#D0D7E5;fontStyle=1;fontSize=14;fontColor=#1F3864;align=center;" vertex="1" parent="1">
          <mxGeometry x="1000" y="110" width="420" height="700" as="geometry" />
        </mxCell>

        <mxCell id="a1" value="① 推送仓库&#xa;+ 加 dsh-plugin topic" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#6B93C9;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="176" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="② 仓库创建满 24 小时&#xa;（CI 硬门槛，等就行）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;dashed=1;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="266" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="③ fork 列表仓库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#6B93C9;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="356" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a4" value="④ 加 1 个文件&#xa;data/plugins/&amp;lt;owner&amp;gt;__&amp;lt;repo&amp;gt;.yml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#6B93C9;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="438" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="a5" value="⑤ 提 PR（只含这 1 个文件）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDEBF7;strokeColor=#6B93C9;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="532" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="a6" value="只该出现 1 个文件&#xa;不要手改 README" style="text;html=1;fontSize=11;fontColor=#9A6700;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="592" width="340" height="34" as="geometry" />
        </mxCell>

        <mxCell id="b1" value="CI 自动检查 4 项&#xa;· 1 个 PR ≤ 3 条&#xa;· package.json 有 dsh.bundle&#xa;· 仓库年龄 ≥ 1 天&#xa;· awesome-lint / 站点构建" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="176" width="340" height="104" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="人工评审（维护者）&#xa;读你的代码，核对描述是否属实&#xa;→ 夸大是主要退回原因" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE4EC;strokeColor=#C97B8B;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="320" width="340" height="76" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="⑥ 合并 PR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#82B366;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="432" width="340" height="52" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="自动：重新生成两份 README&#xa;并重建站点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#82B366;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="520" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="issue 里会列出你这条 PR&#xa;被 ❯ 退回时要做的修改" style="text;html=1;fontSize=11;fontColor=#9A6700;align=left;" vertex="1" parent="1">
          <mxGeometry x="560" y="596" width="340" height="34" as="geometry" />
        </mxCell>

        <mxCell id="c1" value="每日同步&#xa;awesome-dsh-plugin.com/plugins.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#82B366;fontSize=13;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="240" width="340" height="64" as="geometry" />
        </mxCell>
        <mxCell id="c2" value="⑦ 用户在市里搜到&#xa;一键安装 → 重启 → 标题栏出现 ☁" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=14;fontStyle=1;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1040" y="352" width="340" height="76" as="geometry" />
        </mxCell>
        <mxCell id="c3" value="同一个包也服务 DSH 自带的&#xa;Discover（索引源），但那一路&#xa;只收已发布到 npm 的版本" style="text;html=1;fontSize=11;fontColor=#6B7280;align=left;" vertex="1" parent="1">
          <mxGeometry x="1040" y="448" width="340" height="52" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a1" target="a2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a2" target="a3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a3" target="a4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="1" source="a4" target="a5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="PR" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#1F3864;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=11;fontColor=#1F3864;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="a5" target="b1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="490" y="558" />
              <mxPoint x="490" y="228" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e9" value="每日" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#2E7D32;strokeWidth=2.5;endArrow=block;endFill=1;fontSize=11;fontColor=#2E7D32;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b4" target="c1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6B7280;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c1" target="c2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="loop" value="退回（held: author）→ 同分支推修复 + 一条评论，别重开 PR" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#C00000;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=11;fontColor=#C00000;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="b2" target="a5">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="470" y="358" />
              <mxPoint x="470" y="640" />
              <mxPoint x="250" y="640" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="legend" value="图例：蓝＝你要做的　黄＝自动检查/门槛　粉＝人工评审　绿＝完成与用户可见" style="text;html=1;fontSize=12;fontColor=#6B7280;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="826" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="note" value="没有“提交表单”这回事：dshmarket 只是展示端，它每次打开都实时读取 awesome-dsh-plugin.com/plugins.json。所以上架＝被 awesome-dsh-plugin 收录。" style="text;html=1;fontSize=12;fontColor=#1F3864;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1000" y="560" width="400" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
